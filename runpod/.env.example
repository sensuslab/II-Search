# RunPod Environment Variables Example
# Copy to .env and fill in your values

# RunPod Configuration
RUNPOD_API_KEY=your_runpod_api_key_here
RUNPOD_ENDPOINT_ID=your_endpoint_id_here

# Docker Registry
REGISTRY=docker.io/yourusername
IMAGE_NAME=ii-search-4b-runpod
IMAGE_TAG=latest

# HuggingFace (if model is gated)
HF_TOKEN=hf_your_token_here

# Model Configuration (Optimized for Personal Use - Single GPU)
MODEL_NAME=Intelligent-Internet/II-Search-4B
SERVED_MODEL_NAME=II-Search-4B
TENSOR_PARALLEL_SIZE=1
MAX_MODEL_LEN=32768
GPU_MEMORY_UTILIZATION=0.90

# vLLM Features
ENABLE_REASONING=true
REASONING_PARSER=deepseek_r1

# RoPE Scaling (JSON string) - Linear for 32K context
ROPE_SCALING={"rope_type":"linear","factor":2.0}

# Optional: Override vLLM arguments
# VLLM_EXTRA_ARGS=--enable-chunked-prefill --max-num-batched-tokens 8192
