{
  "endpoint": {
    "name": "II-Search-4B-Personal",
    "description": "Personal testing deployment - Single GPU, minimal config",
    "container": {
      "image": "your-registry/ii-search-4b-runpod:latest",
      "disk_size_gb": 15
    },
    "gpu": {
      "type": "A100-80GB",
      "count_per_worker": 1,
      "memory_utilization": 0.90
    },
    "scaling": {
      "type": "queue_delay",
      "min_workers": 0,
      "max_workers": 1,
      "idle_timeout_seconds": 300,
      "execution_timeout_seconds": 300,
      "target_queue_latency_ms": 1000
    },
    "environment": {
      "MODEL_NAME": "Intelligent-Internet/II-Search-4B",
      "SERVED_MODEL_NAME": "II-Search-4B",
      "TENSOR_PARALLEL_SIZE": "1",
      "MAX_MODEL_LEN": "32768",
      "GPU_MEMORY_UTILIZATION": "0.90",
      "ENABLE_REASONING": "true",
      "REASONING_PARSER": "deepseek_r1",
      "ROPE_SCALING": "{\"rope_type\":\"linear\",\"factor\":2.0}",
      "HF_TOKEN": "<SET_IF_MODEL_IS_GATED>"
    },
    "network_volume": {
      "enabled": true,
      "size_gb": 30,
      "mount_path": "/runpod-volume"
    },
    "advanced": {
      "enable_logging": true,
      "log_level": "INFO"
    }
  },
  "alternative_configs": {
    "rtx4090": {
      "description": "Budget option - RTX 4090 24GB",
      "gpu": {
        "type": "RTX4090",
        "count_per_worker": 1
      },
      "environment": {
        "MAX_MODEL_LEN": "16384",
        "GPU_MEMORY_UTILIZATION": "0.85"
      },
      "note": "Cheaper but slower, good for light testing"
    },
    "a5000": {
      "description": "Balanced option - A5000 24GB",
      "gpu": {
        "type": "A5000",
        "count_per_worker": 1
      },
      "environment": {
        "MAX_MODEL_LEN": "24576",
        "GPU_MEMORY_UTILIZATION": "0.88"
      }
    },
    "a100_extended": {
      "description": "Extended context - A100 80GB with longer context",
      "gpu": {
        "type": "A100-80GB",
        "count_per_worker": 1
      },
      "environment": {
        "MAX_MODEL_LEN": "65536",
        "GPU_MEMORY_UTILIZATION": "0.92"
      },
      "scaling": {
        "idle_timeout_seconds": 600
      }
    }
  },
  "notes": [
    "Personal use configuration - single user, minimal requests",
    "1 GPU only - perfect for 4B model (~8GB VRAM required)",
    "Network volume highly recommended for fast cold starts (<30s)",
    "5-minute idle timeout keeps costs minimal",
    "Max 1 worker ensures you never pay for multiple instances",
    "32K context is sufficient for most personal testing needs",
    "Can handle tool use, prompting, and vector store operations efficiently"
  ],
  "cost_estimates": {
    "1x_A100_80GB": {
      "per_second": "$0.00160",
      "per_hour": "$5.76",
      "per_day_1hr_active": "$5.76",
      "per_month_1hr_daily": "$172.80",
      "per_request_5min_idle": "$0.48"
    },
    "1x_RTX4090": {
      "per_second": "$0.00069",
      "per_hour": "$2.48",
      "per_day_1hr_active": "$2.48",
      "per_month_1hr_daily": "$74.40",
      "per_request_5min_idle": "$0.21"
    },
    "1x_A5000": {
      "per_second": "$0.00079",
      "per_hour": "$2.84",
      "per_day_1hr_active": "$2.84",
      "per_month_1hr_daily": "$85.20",
      "per_request_5min_idle": "$0.24"
    }
  },
  "recommended_setup": {
    "beginner_budget": "RTX 4090 - $75/month for 1hr daily use",
    "balanced": "A5000 - $85/month for 1hr daily use",
    "best_performance": "A100 80GB - $173/month for 1hr daily use",
    "occasional_use": "Any GPU with network volume - Pay only when testing"
  }
}
